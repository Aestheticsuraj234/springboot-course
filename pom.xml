<?xml version="1.0" encoding="UTF-8"?>
<!--
  Course root: a pure AGGREGATOR (see chapter 4, "Aggregation vs inheritance").
  `mvn verify` here builds every chapter in one go. Chapters do NOT inherit from this POM;
  each one is a standalone project you can also build from its own folder.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.shopease</groupId>
    <artifactId>maven-course</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Maven Course (all chapters)</name>

    <modules>
        <module>chapter-01-project-structure</module>
        <module>chapter-02-lifecycle-plugins-packaging</module>
        <module>chapter-03-profiles</module>
        <module>chapter-04-multi-module</module>
    </modules>
</project>
